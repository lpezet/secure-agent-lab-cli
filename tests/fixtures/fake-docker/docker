#!/bin/sh
# A fake `docker` for the txtar scripts that exercise sal's Docker-facing
# commands. Put it first on PATH:
#
#   env PATH=$FIXTURES/fake-docker:$PATH
#
# Why this exists rather than real containers: the two findings `sal labs list`
# is FOR — a lab that is running, and a compose project running out of the labs
# directory with no deployment behind it — cannot be produced by starting real
# containers in a test, and the second is not a state anything should be able
# to create on purpose. This makes both deterministic while still exercising
# sal's real exec path and its real JSON decode, rather than a seam cut into
# the production code for tests.
#
# It covers exactly the three invocations sal makes:
#
#   docker compose version                    availability check
#   docker compose ls --all --format json     state of every project
#   docker compose -f FILE VERB...            one deployment
#   docker ps --filter label=...              containers sal did not start
#
# Controlled by environment:
#
#   FAKE_DOCKER_BROKEN   non-zero exit for `version`, i.e. no usable daemon
#   FAKE_DOCKER_LS       file holding the JSON for `ls`; @LABS@ in it is
#                        replaced with the real labs directory, because a txtar
#                        file section cannot hold $WORK and the paths have to
#                        be real for the under-the-labs-directory check to mean
#                        anything
#   FAKE_DOCKER_LOG      appended with "VERB FILE" for every -f invocation, so
#                        a script can assert which labs were acted on
#   FAKE_DOCKER_FAIL     compose files containing this substring exit 1, for
#                        testing that one failure does not abandon the rest
#   FAKE_DOCKER_PORT     what `compose -f FILE port observer 9000` answers.
#                        Unset means the service has no container, which is how
#                        a lab that is not running looks
#   FAKE_DOCKER_LAB      what `compose -f FILE ps --quiet lab` answers. Unset
#                        means the lab service is not up
#   FAKE_DOCKER_PS       what `docker ps` answers for a label query
#   FAKE_DOCKER_PS_OURS  what it answers when the query is narrowed to the
#                        lab's own compose project

# `docker ps` — not a compose call. sal uses it to find a container that is NOT
# part of the deployment: a dev container VS Code started for this project.
# FAKE_DOCKER_PS holds what it answers; a query narrowed to the lab's own
# compose project answers FAKE_DOCKER_PS_OURS instead, which is how a script
# says "that container belongs to something else".
if [ "$1" = ps ]; then
	case "$*" in
	*com.docker.compose.project*) printf '%s' "${FAKE_DOCKER_PS_OURS:+$FAKE_DOCKER_PS_OURS
}" ;;
	*) printf '%s' "${FAKE_DOCKER_PS:+$FAKE_DOCKER_PS
}" ;;
	esac
	exit 0
fi

[ "$1" = compose ] || exit 1

case "$2" in
version)
	exit "${FAKE_DOCKER_BROKEN:-0}"
	;;
ls)
	sed "s|@LABS@|$WORK/.config/secure-agent-lab/labs|g" "$FAKE_DOCKER_LS"
	;;
-f)
	file=$3
	verb=$4
	[ -n "$FAKE_DOCKER_LOG" ] && echo "$verb $file" >>"$FAKE_DOCKER_LOG"
	if [ -n "$FAKE_DOCKER_FAIL" ] && [ "${file#*"$FAKE_DOCKER_FAIL"}" != "$file" ]; then
		echo "fake docker: refusing $file" >&2
		exit 1
	fi
	# `port` answers with a published address and nothing else, because sal
	# reads its stdout. An unset FAKE_DOCKER_PORT is the shape docker has for a
	# service with no container: empty output, exit 0.
	if [ "$verb" = port ]; then
		[ -n "$FAKE_DOCKER_PORT" ] && echo "$FAKE_DOCKER_PORT"
		exit 0
	fi
	# `ps --quiet <service>` is how sal asks whether a service has a container.
	# Empty output is the shape docker has for one that does not.
	if [ "$verb" = ps ]; then
		[ -n "$FAKE_DOCKER_LAB" ] && echo "$FAKE_DOCKER_LAB"
		exit 0
	fi
	# The whole invocation, not just the verb: `sal open` decides which command
	# to run inside the lab, and that decision is only observable here.
	echo "fake docker: $*"
	;;
*)
	exit 1
	;;
esac
