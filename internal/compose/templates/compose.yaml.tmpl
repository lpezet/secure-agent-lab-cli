# Generated by sal for {{ .ProjectDir }}
#
# Do not edit by hand: `sal upgrade` rewrites this file. Anything you add here
# is lost on the next upgrade, which is the trade for the upgrade being able to
# move the security boundary without asking you to merge it.
#
# Per-provider environment deliberately does not appear in this file. Every
# bank manifest declares its own secrets, config and lab_env, and `sal
# providers add` writes those into .env and lab.env — so this file stays
# generic and sal never learns the name of a provider.
name: {{ .ProjectName }}

services:
  broker:
    build: {{ .StackRepo }}#{{ .StackTag }}:stack/broker
    volumes:
      # The secrets directory, and never its parent: the parent also holds the
      # bank cache and every other lab on this machine.
      - {{ .SecretsDir }}:/secrets:ro
      - ./broker:/app/providers:ro
      - audit-logs:/var/log/audit
    env_file: .env
    environment:
      AUDIT_LOG: /var/log/audit/broker.jsonl
    networks: [secure]
    healthcheck:
      test:
        [
          "CMD",
          "node",
          "-e",
          "require('http').get('http://localhost:8080/healthz', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))",
        ]
      interval: 5s
      timeout: 3s
      retries: 5
      start_period: 5s
    restart: unless-stopped

  proxy:
    build: {{ .StackRepo }}#{{ .StackTag }}:stack/proxy
    depends_on:
      broker:
        condition: service_healthy
    volumes:
      - ./proxy:/addons:ro
      - proxy-certs:/home/mitmproxy/.mitmproxy
      - audit-logs:/var/log/audit
    env_file: .env
    environment:
      BROKER_URL: http://broker:8080
      AUDIT_LOG: /var/log/audit/proxy.jsonl
    networks: [secure, lab]
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "test -f /home/mitmproxy/.mitmproxy/mitmproxy-ca-cert.pem",
        ]
      interval: 3s
      timeout: 2s
      retries: 20
      start_period: 5s
    restart: unless-stopped

  cred-gateway:
    build: {{ .StackRepo }}#{{ .StackTag }}:stack/cred-gateway
    depends_on:
      broker:
        condition: service_healthy
    volumes:
      - ./cred-gateway:/etc/nginx/gateway.d:ro
      - audit-logs:/var/log/audit
    networks: [secure, lab]
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost/healthz"]
      interval: 5s
      timeout: 3s
      retries: 5
      start_period: 3s
    restart: unless-stopped

  # Reads the audit-logs volume and serves a live view of it. On NEITHER
  # network, deliberately: it reaches the shared volume without becoming a
  # channel between the secure and lab sides. Do not "fix" that by giving it
  # a network.
  observer:
    build: {{ .StackRepo }}#{{ .StackTag }}:stack/observer
    volumes:
      - audit-logs:/var/log/audit:ro
    ports:
      # No host port is chosen here. The empty slot makes Docker assign one,
      # which `sal observer open` reads back with `docker compose port` — so
      # collisions between labs are impossible rather than tracked somewhere.
      # The 127.0.0.1 prefix stays: this serves the audit trail over plain
      # HTTP with no auth, and is only safe for not being reachable off host.
      - "127.0.0.1::9000"
    healthcheck:
      test:
        [
          "CMD",
          "node",
          "-e",
          "require('http').get('http://localhost:9000/healthz', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))",
        ]
      interval: 5s
      timeout: 3s
      retries: 5
      start_period: 5s
    restart: unless-stopped

  # Rotates the JSONL files and fixes the shared volume's permissions on every
  # start, so broker and proxy — different non-root uids in one directory —
  # can both write. Root for that reason, and on no network either.
  log-rotator:
    build: {{ .StackRepo }}#{{ .StackTag }}:stack/log-rotator
    volumes:
      - audit-logs:/var/log/audit
    restart: unless-stopped

  lab:
    build: {{ if .LabDockerfile }}./lab{{ else }}{{ .StackRepo }}#{{ .StackTag }}:stack/lab{{ end }}
    depends_on:
      proxy:
        condition: service_healthy
      cred-gateway:
        condition: service_healthy
    volumes:
      # The project, and only the project. The deployment lives outside it, so
      # unlike a deployment kept in-tree there is no addon, provider or gateway
      # config here for the agent to edit — and so no read-only shadow mount is
      # needed to protect them.
      - {{ .ProjectDir }}:/workspace:cached
      - proxy-certs:/proxy-certs:ro
    env_file: lab.env
    environment:
      HTTP_PROXY: http://proxy:8080
      HTTPS_PROXY: http://proxy:8080
      NO_PROXY: localhost,127.0.0.1,cred-gateway
      # Both cases, and not for tidiness. gRPC reads `grpc_proxy`, `https_proxy`
      # and `http_proxy` — lowercase only — so with the uppercase forms alone a
      # gRPC client ignores the proxy entirely.
      http_proxy: http://proxy:8080
      https_proxy: http://proxy:8080
      no_proxy: localhost,127.0.0.1,cred-gateway
      NODE_EXTRA_CA_CERTS: /proxy-certs/mitmproxy-ca-cert.pem
      REQUESTS_CA_BUNDLE: /proxy-certs/mitmproxy-ca-cert.pem
      SSL_CERT_FILE: /proxy-certs/mitmproxy-ca-cert.pem
      # gRPC bundles its own roots and reads none of the three above. Without
      # this it does not fail with a TLS error, it retries and hangs.
      GRPC_DEFAULT_SSL_ROOTS_FILE_PATH: /proxy-certs/mitmproxy-ca-cert.pem
    networks: [lab]
    command: sleep infinity

networks:
  # secure is NOT internal: the broker calls provider APIs directly, and the
  # proxy reaches every provider through it.
  secure:
    driver: bridge
  # lab IS internal: no default gateway, so the only way out is the proxy.
  # That is what makes the egress allowlist enforcing rather than advisory —
  # without it, HTTP_PROXY is a request the agent can decline.
  lab:
    driver: bridge
    internal: ${LAB_INTERNAL:-true}

volumes:
  proxy-certs:
  audit-logs:
