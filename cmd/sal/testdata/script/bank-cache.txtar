# Reading a bank straight out of the cache, with the network forbidden.
#
# The cache is seeded by hand below, which is the point: it pins the on-disk
# layout as a contract. A future change that renames commits/ or the provenance
# marker has to change this file too, and that is a diff worth seeing.

cd lab

exec sal providers list --available --offline
stdout 'NAME\s+MIN STACK\s+SUMMARY'
stdout 'acme\s+1\.7\.0'
stdout 'widget\s+1\.9\.0'

# The commit is reported, not just the tag it was reached through.
stderr 'bank at stack v1\.9\.0 \(aaaaaaaaaaaa\)'

# Nothing here needs the entry names to be known to sal. schema/ has no
# manifest, so it is not an entry — decided structurally, not by name.
! stdout 'schema'

# This lab is on v1.9.0, so both entries are installable and neither is
# annotated.
! stdout 'needs stack'
! stderr 'not in a lab'

cd ../oldlab

# Same bank, older lab. Installability is judged against what the LAB runs, not
# against the release the entry was published in — otherwise every entry in a
# bank trivially satisfies its own release and the column says nothing.
exec sal providers list --available --stack v1.9.0 --offline
stdout 'acme\s+1\.7\.0'
stdout 'widget\s+1\.9\.0.*needs stack 1\.9\.0'
stderr 'this lab runs stack v1\.8\.0'

cd ..

# With no lab at all the honest answer is that installability is unknown, so
# nothing is annotated and the reason is stated.
exec sal providers list --available --stack v1.9.0 --offline
! stdout 'needs stack'
stderr 'not in a lab'

-- lab/.sal/installed.json --
{"stack_tag": "v1.9.0", "stack_commit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "installed": []}
-- oldlab/.sal/installed.json --
{"stack_tag": "v1.8.0", "installed": []}
-- .config/secure-agent-lab/bank/refs.json --
{
  "v1.9.0": {
    "commit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "resolved_at": "2026-08-12T00:00:00Z"
  }
}
-- .config/secure-agent-lab/bank/commits/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/.sal-cache.json --
{
  "tag": "v1.9.0",
  "commit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "fetched_at": "2026-08-12T00:00:00Z",
  "files": 4
}
-- .config/secure-agent-lab/bank/commits/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/README.md --
A file, not an entry.
-- .config/secure-agent-lab/bank/commits/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/schema/provider.schema.json --
{"$comment": "a directory with no manifest is not an entry"}
-- .config/secure-agent-lab/bank/commits/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/acme/provider.json --
{
  "schema_version": 1,
  "name": "acme",
  "summary": "Fixture entry served from the cache",
  "min_stack": "1.7.0",
  "load_band": "provider",
  "hosts": ["api.acme.example"],
  "broker_routes": [{ "path": "/acme/token", "exposed": false }]
}
-- .config/secure-agent-lab/bank/commits/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/widget/provider.json --
{
  "schema_version": 1,
  "name": "widget",
  "summary": "Needs a newer stack than the older lab runs",
  "min_stack": "1.9.0",
  "load_band": "provider",
  "hosts": ["api.widget.example"],
  "broker_routes": [{ "path": "/widget/token", "exposed": false }]
}
