# `sal init` creates two trees: a committable pointer in the project, and the
# deployment somewhere the agent cannot see.
#
# Driven with --stack-dir throughout, pointed at the fixture checkout. That is
# the same flag an air-gapped machine would use, and it means no test reaches
# the network — a suite that does fails for reasons unrelated to the code.

cd project

exec sal init --stack-dir $FIXTURES/local-stack
stdout '^lab\s+project-[0-9a-f]{8}$'
stdout '^at\s+.*[/\\]labs[/\\]project-[0-9a-f]{8}$'
stdout '^stack\s+'$DEFAULT_STACK
stdout '^project\s+'

# At 1.10.0 and above the proxy IMAGE carries 000_policy.py and
# 001_allowlist.py and loads them ahead of the /addons mount, so a deployment
# that vendored them would be carrying files the entrypoint skips with a
# warning. Said out loud rather than left as an absence: a reader who knows the
# older shape would otherwise wonder which control went missing.
! stdout '^addon\s+000_policy\.py$'
stdout 'addons   carried by the proxy image at '$DEFAULT_STACK', not vendored here'

# The default release is stated, never silent.
stderr 'pinning to stack '$DEFAULT_STACK
stderr '--stack'

# Reading a local checkout means the release went unverified, so no commit is
# recorded rather than one being invented.
stderr 'unverified and no commit is recorded'
stderr 'sal providers add'

# The project keeps only a pointer — no absolute paths, so it can be committed.
exists .sal/lab.json
grep '"stack_tag": "'$DEFAULT_STACK'"' .sal/lab.json
grep '"name": "project-' .sal/lab.json
! grep '/' .sal/lab.json

# And no install record: that belongs to the deployment, and a second copy here
# would be an answer to "what is installed" that nothing keeps true.
! exists .sal/installed.json

exec sal version
stdout '^stack\s+'$DEFAULT_STACK'$'

# A virgin lab has no PROVIDERS, even though it has addons — the two are
# recorded separately, because a stack addon is not a bank entry and
# check-drift.sh reads `installed` to decide which entries a deployment claims.
exec sal providers list
! stdout .
stderr 'no providers installed'

# Running init twice is refused rather than silently rebuilding a deployment
# that may already have credentials wired into it.
! exec sal init --stack-dir $FIXTURES/local-stack
stderr 'already has a lab'

# A second project gets its own lab, at a release it names itself.
cd $WORK/other
exec sal init --stack-dir $FIXTURES/local-stack --stack v1.13.0
stdout '^lab\s+other-[0-9a-f]{8}$'
stdout '^stack\s+v1\.13\.0'
! stderr 'pinning to stack'

# Names derive from the path, so two projects with the same basename do not
# collide — and a lab nested inside another project's tree warns, because it is
# usually a mistake even though it is allowed.
cd $WORK/nested/project
exec sal init --stack-dir $FIXTURES/local-stack
stdout '^lab\s+project-[0-9a-f]{8}$'
stderr 'nested inside one tree'

# A checkout with no addons directory is no longer a problem at all: from
# stack 1.10.0 the proxy image carries them, and sal only creates labs at
# releases newer than that — so those files were never this deployment's to
# hold. The refusal that used to be here belonged to a lab shape sal can no
# longer produce; `sal drift` still knows the older one, for labs it did not
# create.
cd $WORK/no-addons-project
exec sal init --stack-dir $WORK/hollow-stack
stdout 'carried by the proxy image'
exists .sal/lab.json

# A checkout with no TEMPLATE is refused, though — there is no wiring to
# install, and a deployment directory with no compose file is not a lab.
cd $WORK/no-template-project
! exec sal init --stack-dir $WORK/templateless-stack
stderr 'cannot obtain the deployment template'
! exists .sal/lab.json

# So is a release older than the one whose template sal can use verbatim. Below
# it the file names specific bank entries in the broker's environment, and
# `environment:` wins over `env_file:` — a lab built from it would read
# credential paths the template chose over the ones its manifests declare.
! exec sal init --stack v1.11.3 --stack-dir $FIXTURES/local-stack
stderr 'only usable from v1\.12\.0'
! exists .sal/lab.json


-- project/.keep --
-- older/.keep --
-- other/.keep --
-- no-addons-project/.keep --
-- no-template-project/.keep --
-- templateless-stack/bank/.keep --
-- hollow-stack/bank/.keep --
-- hollow-stack/template/deployment/compose.yaml --
name: secure-agent-lab
services:
  broker:
    build: https://github.com/lpezet/secure-agent-lab.git#v1.12.0:stack/broker
-- hollow-stack/template/deployment/allowlist --
# Nothing allowed by default.
-- hollow-stack/template/deployment/lab/Dockerfile --
FROM debian:stable-slim
-- hollow-stack/template/deployment/lab/entrypoint.sh --
#!/usr/bin/env bash
exec "$@"
-- nested/.sal/lab.json --
{"schema_version": 1, "name": "outer-lab", "stack_tag": "v1.9.0"}
-- nested/project/.keep --
-- .config/secure-agent-lab/labs/outer-lab/compose.yaml --
name: outer-lab
