# There is no flag that takes a credential value, and there will not be one.
#
# A credential in argv is in shell history, in ps, and in any process listing
# the agent can run. This is the one invariant a future contributor is most
# likely to break for convenience — `--value` costs nothing to add and looks
# helpful — so it gets a test rather than a comment.

exec sal secrets set --help

# The flags that must not exist. Every one of them puts the VALUE in argv.
! stdout '--value'
! stdout '--from-literal'
! stdout '--password'
! stdout '--token'
! stdout '--secret[ =]'

# `! stdout '--stdin'` used to sit in that list, and it was wrong — kept here
# as a correction rather than deleted, so the reasoning is not re-derived and
# put back. It conflated a value in ARGV with a value on STDIN, which are
# different exposures: argv is in shell history, in ps, and in any process
# listing the agent can run, while stdin is none of those. Refusing it left no
# way to take a credential from a secret manager without writing plaintext to
# disk first, which is worse than what the refusal was protecting against.
stdout '--from-stdin'

# --from-file and --from-stdin are the two that DO exist, and neither is an
# exception to the rule. The help has to carry the distinction, or the next
# person reads them as a precedent for --from-literal.
stdout '--from-file'
stdout 'PATH in an argv reveals nothing'
stdout 'stdin is not an argv at all'

# The help says why, so someone about to add one reads the reason first.
stdout 'shell history'

# There is no --type either. Which credential to set is named by the manifest,
# not guessed from the value's shape and not described by a flag this CLI would
# have to know the meanings of — that would be per-provider knowledge wearing a
# flag's clothes.
! stdout '--type'

# A credential is named by its file, and the help says why the env var is not
# an alternative spelling — that confusion is what the file naming replaced.
stdout 'named by its FILE'
stdout 'path inside'

# The command takes the NAME of what to set, and nothing else.
! exec sal secrets set
stderr 'accepts between 1 and 2 arg'

# A pipe nobody asked for is still REFUSED. `echo $TOKEN | sal secrets set ...`
# does put the credential in an argv one process upstream, and it would look
# like it worked — and every non-terminal context that was never meant to be an
# input, a cron job or a CI runner or a stray `< /dev/null`, stays an error
# rather than quietly becoming one. Nothing is a terminal under testscript, so
# this is the real path.
! exec sal secrets set acme --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stderr 'not a terminal'
stderr 'argv one process away'

# And the refusal names the way through, since someone piping deliberately has
# no other way to find it.
stderr 'pass --from-stdin'
