# `sal providers list` reads the deployment's .sal/installed.json rather than
# guessing from filenames, and `--available` reads the bank at the release the
# lab was built from.
#
# Nothing here touches the network: the paths that would are driven with
# --offline, which is itself the thing being asserted.

# Outside a project with a lab there is nothing to list, and the error says
# what is missing rather than printing an empty table.
! exec sal providers list
stderr 'no lab for this directory'
stderr 'sal init'

cd empty-project

# A lab with nothing installed is not an error. The message goes to stderr so
# that piping stdout yields an empty list, not prose.
exec sal providers list
! stdout .
stderr 'no providers installed'

cd ../stocked-project

exec sal providers list
stdout 'NAME\s+SLOT\s+SCHEMA\s+FROM'

# The slot is printed with its leading zeros, because that is how it appears in
# the filename the installer assigned.
stdout 'acme\s+010\s+1\s+v1\.9\.0'
stdout 'widget\s+011\s+1\s+v1\.9\.0'

# --available needs to know which release to read the bank at. With no lab that
# is unanswerable, and the error says how to answer it.
cd ..
! exec sal providers list --available
stderr 'no lab for this directory'
stderr '--stack'

# A local checkout with no bank in it fails immediately and names what is
# missing, rather than reaching for the network it was told not to use.
! exec sal providers list --available --stack v1.9.0 --stack-dir $WORK/empty-stack
stderr 'has no bank directory'

# A malformed release tag is refused before any request is attempted.
! exec sal providers list --available --stack main --stack-dir $WORK/empty-stack
! exec sal providers list --available --stack ../../etc --stack-dir $WORK/empty-stack

-- empty-stack/.keep --
-- empty-project/.sal/lab.json --
{"schema_version": 1, "name": "empty-lab", "stack_tag": "v1.9.0"}
-- stocked-project/.sal/lab.json --
{"schema_version": 1, "name": "stocked-lab", "stack_tag": "v1.9.0"}
-- .config/secure-agent-lab/labs/empty-lab/compose.yaml --
name: empty-lab
-- .config/secure-agent-lab/labs/empty-lab/.sal/installed.json --
{"schema_version": 1, "stack_tag": "v1.9.0", "installed": []}
-- .config/secure-agent-lab/labs/stocked-lab/compose.yaml --
name: stocked-lab
-- .config/secure-agent-lab/labs/stocked-lab/.sal/installed.json --
{
  "schema_version": 1,
  "stack_tag": "v1.9.0",
  "stack_commit": "3ef8552aa",
  "installed": [
    {"name": "acme",   "slot": 10, "schema_version": 1, "files": ["proxy/010_acme.py"]},
    {"name": "widget", "slot": 11, "schema_version": 1, "files": ["proxy/011_widget.py"]}
  ]
}
