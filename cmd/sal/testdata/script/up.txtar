# `sal up` — and the restart that makes every other message in this CLI true.
#
# Five messages tell the operator to run `sal up` after changing something in
# the deployment: `allowlist allow`, `deny` and `reset`, and `providers add`
# and `remove`. All five are right about what should happen and, until this,
# named a command that did not do it.
#
# Everything a service reads from the deployment arrives through a BIND MOUNT
# and is read at container start — a broker provider, a proxy addon, a
# cred-gateway config, a lab_setup fragment, the egress allowlist. So changing
# one changes the FILE and not the container's config, and `docker compose up`
# correctly finds nothing to do. The container keeps what it read when it
# started.
#
# It was found the hard way, against a real lab: `sal allowlist allow` said to
# run `sal up`, `sal up` reported the lab up in 2s, and the proxy went on
# denying the destination. tests/compose/run.sh pins the compose semantics
# underneath; this pins what sal does about them.

[windows] skip 'the fake docker is a /bin/sh script'

env PATH=$FIXTURES/fake-docker:$PATH
env FAKE_DOCKER_LOG=$WORK/calls.log

cd project

# ------------------------------------------------- a lab that is not running
#
# Nothing to restart, and nothing said about one. Every container is about to
# be created and each reads the current files on the way up — a restart here
# would be pure cost, and a line claiming one would be a lie about work that
# did not happen.
exec sal up
! stderr 'restarted'
! grep '^restart ' $WORK/calls.log

# ----------------------------------------------------- a lab that is running
#
# The services that were already up are restarted, and BEFORE `up` rather than
# after: `restart` has no --wait of its own, so reporting a lab up while its
# proxy is still coming back would be the same class of lie this exists to
# remove. `up --wait` afterwards is what waits for health.
rm $WORK/calls.log
env FAKE_DOCKER_RUNNING='broker proxy cred-gateway lab observer log-rotator'
exec sal up
stderr 'files at startup'
grep '^restart ' $WORK/calls.log

# A DENY-list, not an allow-list: everything running is restarted unless it is
# one of the two services on NEITHER network. A service the stack adds is
# covered without sal being taught about it, because the direction that must
# not fail is a boundary file left stale.
stderr 'restarted broker, cred-gateway, lab, proxy'

# And the two that are skipped. Not tidiness: `docker compose restart`
# reassigns a host port the compose file left to Docker, and the observer's is
# left to Docker on purpose — so restarting it for nothing would move the audit
# trail's URL on every `sal up`. Neither is on a network, so neither can be the
# one holding a stale boundary file.
! stderr 'observer,'
! stderr 'log-rotator'

# The order, which is the half that cannot be seen from the output: of the two
# verbs that act on containers, `restart` is first.
exec sh -c 'grep -E "^(restart|up) /" $WORK/calls.log | head -1'
stdout '^restart '

# ------------------------------------------------------- one service running
#
# The answer is not all-or-nothing: a lab part-way up restarts what is up and
# lets `up` create the rest.
rm $WORK/calls.log
env FAKE_DOCKER_RUNNING=proxy
exec sal up
stderr 'restarted proxy'
! stderr 'restarted proxy, '

# ------------------------------------------------------------- --build
#
# The build is its own compose call now, not a flag on the `up`. It has to be,
# because `up` has no --build-arg and the declarative route (`args:` on the lab
# service) lives in a file sal fetches verbatim and `sal upgrade` rewrites.
# One path for both flags: `--build` and `--build-arg` differing in what they
# build is a distinction nobody would expect to exist.
rm $WORK/calls.log
env FAKE_DOCKER_RUNNING=
exec sal up --build
stdout 'compose build'
! stdout 'up -d --wait --build'

# ---------------------------------------------------------- --build-arg
#
# Repeatable, passed through in the order given and unaltered — a build arg's
# value is the operator's text and sal has no business interpreting it.
rm $WORK/calls.log
exec sal up --build-arg CLAUDE_VERSION=1.2.3 --build-arg TZ=Europe/Paris
stdout 'compose build --build-arg CLAUDE_VERSION=1.2.3 --build-arg TZ=Europe/Paris'

# It implies --build. The alternative is an argument accepted for a build that
# never runs, which is a value silently not applied — the exact failure the
# flag exists to end.
grep '^build ' $WORK/calls.log

# The bare form, which compose resolves from sal's own environment. It is what
# makes `CLAUDE_VERSION=$(curl ...) sal up --build-arg CLAUDE_VERSION` read the
# way it looks like it reads.
rm $WORK/calls.log
exec sal up --build-arg CLAUDE_VERSION
stdout 'compose build --build-arg CLAUDE_VERSION'

# A value is NOT a place for a credential, and the help says so rather than
# leaving it to be discovered: an ARG's value is in the image's build history.
exec sal up --help
stdout 'docker history'
stdout 'sal secrets set'

# A key that is not a key is refused before anything runs, rather than handed
# to compose to reject halfway through.
rm $WORK/calls.log
! exec sal up --build-arg =1.2.3
stderr 'expected KEY=VALUE'
! exists $WORK/calls.log

# ------------------------------------------------- a build that fails
#
# It runs BEFORE the restart, so a lab that was up and healthy is still up and
# healthy. Restarting first and then failing to build would bounce every
# service in the deployment for a command that accomplished nothing.
env FAKE_DOCKER_RUNNING='broker proxy'
env FAKE_DOCKER_FAIL_VERB=build
! exec sal up --build-arg CLAUDE_VERSION=1.2.3
! grep '^restart ' $WORK/calls.log
! grep '^up ' $WORK/calls.log
env FAKE_DOCKER_FAIL_VERB=

-- project/.sal/lab.json --
{"schema_version": 1, "name": "demo-lab", "stack_tag": "v1.13.1"}
-- .config/secure-agent-lab/labs/demo-lab/compose.yaml --
name: demo-lab
-- .config/secure-agent-lab/labs/demo-lab/.env --
COMPOSE_PROJECT_NAME=demo-lab
COMPOSE_PROFILES=observer
-- .config/secure-agent-lab/labs/demo-lab/lab.env --
# lab only
-- .config/secure-agent-lab/labs/demo-lab/.sal/installed.json --
{"schema_version": 1, "stack_tag": "v1.13.1", "base_addons": [], "installed": []}
