# `sal secrets set` walks the credentials a manifest declares, and knows
# nothing about any of them.
#
# The fixture provider acme declares two — one multiline, one optional — which
# is the shape that makes every question in this file worth asking: which one
# did you mean, where does it go, and what happens when it is already set.
#
# Driven with --stack-dir throughout, so no test reaches the network.

# A provider that declares no credentials says so, rather than dropping into a
# prompt for nothing.
! exec sal secrets set widget --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stderr 'declares no credentials'

# A credential is named by its FILE, exactly. There is no substring matching
# and no ambiguity to resolve: Validate rejects a manifest whose secrets share
# a file, so an exact match on a unique field is unambiguous by construction.
! exec sal secrets set acme acme --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stderr 'no credential named'

# The refusal lists both columns — the name that selects, and the manifest's
# own wording — so the operator can act on it without opening provider.json.
stderr 'acme-app\.pem'
stderr 'Acme private key'
stderr 'acme-webhook\.txt'

# The ENV NAME must not work: it names the variable the broker reads, whose
# value is a path inside the container, not the credential. But it gets a
# refusal that points at the right name rather than one claiming the credential
# does not exist — someone typing this has read a deployment's .env and
# reasoned backwards.
! exec sal secrets set acme ACME_PRIVATE_KEY_PATH --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stderr 'environment variable'
stderr 'path inside the container'
stderr 'acme-app\.pem'

# An unknown one shows what IS available.
! exec sal secrets set acme nosuchthing --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stderr 'no credential named'
stderr 'acme-app\.pem'

# --from-file is the scriptable path: it needs no terminal, because a PATH in
# an argv reveals nothing.
exec sal secrets set acme acme-app.pem --from-file key.pem --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stdout 'wrote .*acme-app\.pem \(0600\)'

# It went to the filename the MANIFEST names, not to anything derived from the
# provider name or the source file's name.
exists $HOME/.config/secure-agent-lab/secrets/acme-app.pem
! exists $HOME/.config/secure-agent-lab/secrets/key.pem
! exists $HOME/.config/secure-agent-lab/secrets/acme.pem

# A PEM is stored verbatim, trailing newline included — some parsers reject it
# without one.
cmp $HOME/.config/secure-agent-lab/secrets/acme-app.pem key.pem

# A second --from-file run does NOT silently rotate. Overwriting is confirmed,
# and with no terminal to confirm on the answer is no — so a scripted re-run
# leaves the credential alone instead of replacing it with whatever the script
# happened to be pointed at this time.
exec sal secrets set acme acme-app.pem --from-file other.pem --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stderr 'already set'
stderr 'left acme-app\.pem alone'
cmp $HOME/.config/secure-agent-lab/secrets/acme-app.pem key.pem

# A single-line credential is trimmed on the way in: a token read out of a file
# carries the newline an editor put there, and passing it through produces an
# invalid Authorization header that fails much later as a 401.
exec sal secrets set acme acme-webhook.txt --from-file webhook.txt --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stdout 'wrote .*acme-webhook\.txt'

# Anchored to the whole file rather than to a line: a line-anchored match would
# pass with the newline still on the end, which is the exact bug this guards.
grep '\Ask-test-webhook-value\z' $HOME/.config/secure-agent-lab/secrets/acme-webhook.txt

# An empty file does not store an empty credential. The optional one is left
# unset and said so — by its FILE, since that is the only name for a credential
# anywhere in this command's output.
exec sal secrets set acme acme-webhook.txt --from-file empty.txt --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stderr 'left acme-webhook\.txt unset \(optional\)'
! stderr 'ACME_WEBHOOK_SECRET_PATH'

# --from-file names one credential, so it is refused when the selector leaves
# more than one in play — rather than writing the same bytes into both.
! exec sal secrets set acme --from-file key.pem --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stderr '--from-file sets one credential'

# A path that does not exist is an error, not a credential whose value happens
# to look like a path.
! exec sal secrets set acme acme-webhook.txt --from-file nope.txt --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stderr 'no such file'

# A directory is refused rather than read.
mkdir adir
! exec sal secrets set acme acme-webhook.txt --from-file adir --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stderr 'is a directory'

# `secrets list` reports what is set without printing any of it.
exec sal secrets list acme --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stdout 'acme-app\.pem\s+set — 0600'
stdout 'acme-webhook\.txt\s+set — 0600'

# The manifest's own wording sits under each, so the listing reads without
# provider.json open.
stdout 'Acme private key'

# The ENV NAME is deliberately absent. It is the vocabulary the selector gave
# up, and printing it here would teach it right back.
! stdout 'ACME_PRIVATE_KEY_PATH'
! stdout 'ACME_WEBHOOK_SECRET_PATH'

# And never a value.
! stdout 'sk-test-webhook-value'
! stdout 'BEGIN TEST KEY'

# An unset optional credential says which it is, so a blank is not read as a
# missing step.
exec sal secrets list widget --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stdout 'widget'

# A credential no installed provider claims is reported. It is not clutter: it
# is a live secret mounted into every broker on this machine that nothing
# reads.
cp key.pem $HOME/.config/secure-agent-lab/secrets/forgotten.token
exec sal secrets list acme --stack v1.9.0 --stack-dir $FIXTURES/local-stack
stdout 'claimed by no installed provider'
stdout 'forgotten\.token'
stdout 'mounted into every broker'

-- empty.txt --
-- key.pem --
-----BEGIN TEST KEY-----
YWNtZS10ZXN0LWtleS1tYXRlcmlhbA==
-----END TEST KEY-----
-- other.pem --
-----BEGIN OTHER TEST KEY-----
b3RoZXItdGVzdC1rZXktbWF0ZXJpYWw=
-----END OTHER TEST KEY-----
-- webhook.txt --
sk-test-webhook-value
